<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>
    <groupId>com.example</groupId>
    <artifactId>ai-task-platform</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>ai-task-platform</name>
    <description>Independent AI text task platform</description>
    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <properties>
        <java.version>17</java.version>
        <maven.compiler.release>17</maven.compiler.release>
        <junit-jupiter.version>5.13.4</junit-jupiter.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Override while an existing Windows process holds the default target JAR open. -->
        <platform.build.directory>${project.basedir}/target</platform.build.directory>
    </properties>
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-amqp</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>org.mockito</groupId>
                    <artifactId>mockito-core</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.mockito</groupId>
                    <artifactId>mockito-junit-jupiter</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
    </dependencies>
    <build>
        <directory>${platform.build.directory}</directory>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
    <!-- Real database acceptance is never bound to the default build. -->
    <profiles>
        <profile>
            <id>model-http-it</id>
            <build><plugins><plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <includes><include>**/*ModelHttpIT.java</include></includes>
                    <failIfNoTests>true</failIfNoTests>
                    <systemPropertyVariables>
                        <phase4c.model.http.enabled>true</phase4c.model.http.enabled>
                        <logback.configurationFile>mysql-it-logback.xml</logback.configurationFile>
                    </systemPropertyVariables>
                </configuration>
                <executions><execution><goals><goal>integration-test</goal><goal>verify</goal></goals></execution></executions>
            </plugin></plugins></build>
        </profile>
        <profile>
            <id>worker-lease-it</id>
            <build><plugins><plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <includes><include>**/*LeaseIT.java</include></includes>
                    <failIfNoTests>true</failIfNoTests>
                    <systemPropertyVariables>
                        <phase4b.lease.enabled>true</phase4b.lease.enabled>
                        <logback.configurationFile>mysql-it-logback.xml</logback.configurationFile>
                    </systemPropertyVariables>
                </configuration>
                <executions><execution><goals><goal>integration-test</goal><goal>verify</goal></goals></execution></executions>
            </plugin></plugins></build>
        </profile>
        <profile>
            <id>outbox-it</id>
            <build><plugins><plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <includes><include>**/*OutboxIT.java</include></includes>
                    <failIfNoTests>true</failIfNoTests>
                    <systemPropertyVariables>
                        <phase4a.outbox.enabled>true</phase4a.outbox.enabled>
                        <logback.configurationFile>mysql-it-logback.xml</logback.configurationFile>
                    </systemPropertyVariables>
                </configuration>
                <executions><execution><goals><goal>integration-test</goal><goal>verify</goal></goals></execution></executions>
            </plugin></plugins></build>
        </profile>
        <profile>
            <id>redis-it</id>
            <build><plugins><plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <includes><include>**/*RedisIT.java</include></includes>
                    <failIfNoTests>true</failIfNoTests>
                    <systemPropertyVariables>
                        <phase3b.redis.enabled>true</phase3b.redis.enabled>
                        <phase3b.app.jar>${project.build.directory}/${project.build.finalName}.jar</phase3b.app.jar>
                        <phase3b.output>${project.build.directory}</phase3b.output>
                        <logback.configurationFile>mysql-it-logback.xml</logback.configurationFile>
                    </systemPropertyVariables>
                </configuration>
                <executions><execution><goals><goal>integration-test</goal><goal>verify</goal></goals></execution></executions>
            </plugin></plugins></build>
        </profile>
        <profile>
            <id>rabbit-it</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <configuration>
                            <includes><include>**/*RabbitIT.java</include></includes>
                            <failIfNoTests>true</failIfNoTests>
                            <systemPropertyVariables>
                                <phase3a.rabbit.enabled>true</phase3a.rabbit.enabled>
                                <logback.configurationFile>mysql-it-logback.xml</logback.configurationFile>
                            </systemPropertyVariables>
                        </configuration>
                        <executions>
                            <execution>
                                <goals><goal>integration-test</goal><goal>verify</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>mysql-it</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <configuration>
                            <includes>
                                <include>**/*MySqlIT.java</include>
                            </includes>
                            <failIfNoTests>true</failIfNoTests>
                            <systemPropertyVariables>
                                <phase2b.mysql.enabled>true</phase2b.mysql.enabled>
                                <logback.configurationFile>mysql-it-logback.xml</logback.configurationFile>
                            </systemPropertyVariables>
                        </configuration>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>integration-test</goal>
                                    <goal>verify</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
